import pandas as pd
import numpy as np

np.random.seed(42)

# Create placement data for students
placements = pd.DataFrame({
    "placement_id": range(1, 801),
    "student_id": np.random.choice(
        students["student_id"],
        800,
        replace=False
    ),
    "company_name": np.random.choice(
        [
            "TCS",
            "Infosys",
            "Wipro",
            "Accenture",
            "Deloitte",
            "Cognizant",
            "Capgemini",
            "Tech Mahindra"
        ],
        800
    ),
    "job_role": np.random.choice(
        [
            "Software Developer",
            "Data Analyst",
            "Web Developer",
            "Business Analyst",
            "System Engineer"
        ],
        800
    ),
    "package_lpa": np.round(
        np.random.uniform(3, 12, 800),
        2
    ),
    "placement_status": "Placed"
})

placements.head()

placement_rate = (
    placements["placement_status"]
    .eq("Placed")
    .mean() * 100
)

print("Placement Rate:", round(placement_rate, 2), "%")

total_students = len(students)

placed_students = (
    placements["placement_status"]
    .eq("Placed")
    .sum()
)

placement_rate = (
    placed_students / total_students
) * 100

print("Total Students:", total_students)
print("Placed Students:", placed_students)
print("Placement Rate:", round(placement_rate, 2), "%")


average_package = placements[
    placements["placement_status"] == "Placed"
]["package_lpa"].mean()

print("Average Package:", round(average_package, 2), "LPA")

placements.to_csv(
    "placements.csv",
    index=False
)

print("placements.csv created successfully!")




