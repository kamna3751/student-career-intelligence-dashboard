import numpy as np

np.random.seed(42)

student_skills_list = []

for student_id in students["student_id"]:

    # Each student gets 2 to 7 skills
    number_of_skills = np.random.randint(2, 8)

    selected_skills = np.random.choice(
        skills["skill_id"],
        number_of_skills,
        replace=False
    )

    for skill_id in selected_skills:

        proficiency = np.random.choice(
            ["Beginner", "Intermediate", "Advanced"],
            p=[0.30, 0.50, 0.20]
        )

        student_skills_list.append({
            "student_id": student_id,
            "skill_id": skill_id,
            "proficiency": proficiency
        })

student_skills = pd.DataFrame(student_skills_list)

print("Student-skill records:", len(student_skills))

student_skills.head()




