np.random.seed(42)

projects_list = []

project_names = [
    "Student Management System",
    "E-Commerce Website",
    "Data Analytics Dashboard",
    "Hospital Management System",
    "Student Career Dashboard",
    "Weather Application",
    "Expense Tracker",
    "Food Delivery Application",
    "Library Management System",
    "Portfolio Website"
]

project_domains = [
    "Web Development",
    "Data Analytics",
    "Python",
    "Database",
    "Software Development"
]

project_id = 1

for student_id in students["student_id"]:

    number_of_projects = np.random.randint(0, 6)

    for _ in range(number_of_projects):

        projects_list.append({
            "project_id": project_id,
            "student_id": student_id,
            "project_name": np.random.choice(project_names),
            "project_domain": np.random.choice(project_domains),
            "technology": np.random.choice([
                "Python",
                "Java",
                "React",
                "HTML/CSS",
                "SQL",
                "Power BI"
            ])
        })

        project_id += 1

projects = pd.DataFrame(projects_list)

print("Projects:", len(projects))
projects.head()




np.random.seed(42)

placement_data = []

companies = [
    "TCS",
    "Infosys",
    "Wipro",
    "Accenture",
    "Deloitte",
    "Cognizant",
    "Capgemini",
    "Tech Mahindra"
]

roles = [
    "Software Developer",
    "Data Analyst",
    "Web Developer",
    "Business Analyst",
    "System Engineer"
]

for student_id in students["student_id"]:

    student = students[
        students["student_id"] == student_id
    ].iloc[0]

    # Calculate a simple career score
    score = 0

    # CGPA contribution
    score += (student["cgpa"] / 10) * 35

    # Aptitude contribution
    score += (student["aptitude_score"] / 100) * 25

    # Communication contribution
    score += (student["communication_score"] / 100) * 15

    # Random factor
    score += np.random.uniform(0, 25)

    if score >= 55:

        placement_status = "Placed"

        company = np.random.choice(companies)

        role = np.random.choice(roles)

        package = round(
            np.random.uniform(3.0, 12.0),
            2
        )

    else:

        placement_status = "Not Placed"

        company = "N/A"
        role = "N/A"
        package = 0

    placement_data.append({
        "student_id": student_id,
        "company_name": company,
        "job_role": role,
        "package_lpa": package,
        "placement_status": placement_status
    })

placements = pd.DataFrame(placement_data)

placements.insert(
    0,
    "placement_id",
    range(1, len(placements) + 1)
)

print("Placement records:", len(placements))

placements.head()




np.random.seed(42)

company_requirements_list = []

companies = [
    "TCS",
    "Infosys",
    "Wipro",
    "Accenture",
    "Deloitte",
    "Cognizant",
    "Capgemini",
    "Tech Mahindra"
]

job_roles = [
    "Software Developer",
    "Data Analyst",
    "Web Developer",
    "Business Analyst"
]

requirement_id = 1

for company in companies:

    for role in job_roles:

        selected_skills = np.random.choice(
            skills["skill_id"],
            5,
            replace=False
        )

        for skill_id in selected_skills:

            required_level = np.random.choice(
                ["Intermediate", "Advanced"],
                p=[0.7, 0.3]
            )

            company_requirements_list.append({
                "requirement_id": requirement_id,
                "company_name": company,
                "job_role": role,
                "skill_id": skill_id,
                "required_level": required_level
            })

            requirement_id += 1

company_requirements = pd.DataFrame(
    company_requirements_list
)

print(
    "Company requirements:",
    len(company_requirements)
)

company_requirements.head()




