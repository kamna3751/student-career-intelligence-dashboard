import pandas as pd
import numpy as np

np.random.seed(42)

n = 1000

students = pd.DataFrame({
    "student_id": range(1, n + 1),
    "name": [f"Student_{i}" for i in range(1, n + 1)],
    "gender": np.random.choice(
        ["Male", "Female", "Other"], n
    ),
    "branch": np.random.choice(
        ["CSE", "IT", "ECE", "CSE-DS", "CSE-AI"], n
    ),
    "graduation_year": np.random.choice(
        [2026, 2027], n
    ),
    "cgpa": np.round(
        np.random.uniform(5.5, 9.8, n), 2
    ),
    "aptitude_score": np.round(
        np.random.uniform(40, 100, n), 2
    ),
    "communication_score": np.round(
        np.random.uniform(40, 100, n), 2
    )
})

students.to_csv(
    "students.csv",
    index=False
)



