CREATE DATABASE IF NOT EXISTS career_intelligence;

USE career_intelligence;

CREATE TABLE IF NOT EXISTS students (
    student_id INT PRIMARY KEY,
    name VARCHAR(100),
    gender VARCHAR(20),
    branch VARCHAR(50),
    graduation_year INT,
    cgpa DECIMAL(3,2),
    aptitude_score DECIMAL(5,2),
    communication_score DECIMAL(5,2)
);

CREATE TABLE IF NOT EXISTS skills (
    skill_id INT PRIMARY KEY,
    skill_name VARCHAR(100),
    skill_category VARCHAR(50)
);

CREATE TABLE IF NOT EXISTS student_skills (
    student_id INT,
    skill_id INT,
    proficiency VARCHAR(30),
    PRIMARY KEY (student_id, skill_id),
    FOREIGN KEY (student_id) REFERENCES students(student_id),
    FOREIGN KEY (skill_id) REFERENCES skills(skill_id)
);

CREATE TABLE IF NOT EXISTS internships (
    internship_id INT PRIMARY KEY,
    student_id INT,
    company_name VARCHAR(100),
    domain VARCHAR(100),
    duration_months INT,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
);

CREATE TABLE IF NOT EXISTS projects (
    project_id INT PRIMARY KEY,
    student_id INT,
    project_name VARCHAR(150),
    project_domain VARCHAR(100),
    technology VARCHAR(100),
    FOREIGN KEY (student_id) REFERENCES students(student_id)
);

CREATE TABLE IF NOT EXISTS placements (
    placement_id INT PRIMARY KEY,
    student_id INT,
    company_name VARCHAR(100),
    job_role VARCHAR(100),
    package_lpa DECIMAL(6,2),
    placement_status VARCHAR(30),
    FOREIGN KEY (student_id) REFERENCES students(student_id)
);

CREATE TABLE IF NOT EXISTS company_requirements (
    requirement_id INT PRIMARY KEY,
    company_name VARCHAR(100),
    job_role VARCHAR(100),
    skill_id INT,
    required_level VARCHAR(30),
    FOREIGN KEY (skill_id) REFERENCES skills(skill_id)
);
